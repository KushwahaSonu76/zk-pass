{
  "name": "zkpass-core",
  "version": "1.0.0",
  "private": true,
  "description": "Private Credential & Access Layer built on Midnight Blockchain using Compact zero-knowledge circuits.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:frontend": "npm run --prefix frontend build",
    "dev:frontend": "npm run --prefix frontend dev",
    "dev:indexer": "npm run --prefix indexer dev",
    "build": "npm run build:frontend"
  },
  "workspaces": [
    "contract",
    "frontend",
    "indexer"
  ],
  "devDependencies": {
    "happy-dom": "^14.12.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}
